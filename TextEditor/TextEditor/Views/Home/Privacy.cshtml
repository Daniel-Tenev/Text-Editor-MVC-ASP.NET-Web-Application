@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5" style="background: linear-gradient(180deg, #fff9f5 0%, #faf7f2 100%); border-radius: 18px; box-shadow: 0 4px 14px rgba(100, 80, 60, 0.08);">
    <div class="px-4 py-4">

        <h1 class="display-6 fw-bold mb-4 text-center" style="color:#a85e28;">@ViewData["Title"]</h1>

        <section class="mb-4">
            <h2 class="h5 text-warning mb-2">1. Introduction</h2>
            <p style="color:#3c2f2f; line-height:1.6;">
                Welcome to <strong>Словоредактор</strong>. Your privacy is important to us.
                This Privacy Policy explains how we collect, use, and protect your information when you use our online text editor.
            </p>
        </section>

        <section class="mb-4">
            <h2 class="h5 text-warning mb-2">2. Information We Collect</h2>
            <p style="color:#3c2f2f; line-height:1.6;">
                We do not collect personal data from users unless explicitly provided. However, we may collect limited non-personal data, such as:
            </p>
            <ul style="color:#3c2f2f; line-height:1.6;">
                <li>Usage data (e.g., features used, interaction patterns) to improve our services.</li>
                <li>Cookies or similar technologies to enhance user experience (only if applicable).</li>
            </ul>
        </section>

        <section class="mb-4">
            <h2 class="h5 text-warning mb-2">3. How We Use Your Information</h2>
            <ul style="color:#3c2f2f; line-height:1.6;">
                <li>Enhancing and optimizing the functionality of the editor.</li>
                <li>Ensuring security and stability of our platform.</li>
                <li>Providing user support if requested.</li>
            </ul>
        </section>

        <section class="mb-4">
            <h2 class="h5 text-warning mb-2">4. Data Storage and Security</h2>
            <p style="color:#3c2f2f; line-height:1.6;">
                We prioritize the security of your data. Documents created in the text editor are not stored on our servers unless explicitly saved by the user.
                If cloud storage or synchronization features are enabled, data will be stored in compliance with respective service provider policies.
            </p>
        </section>

        <section class="mb-4">
            <h2 class="h5 text-warning mb-2">5. Third-Party Services</h2>
            <p style="color:#3c2f2f; line-height:1.6;">
                Our platform may integrate third-party services (e.g., cloud storage, authentication providers).
                These services operate under their respective privacy policies, and we encourage users to review them.
            </p>
        </section>

        <section class="mb-4">
            <h2 class="h5 text-warning mb-2">6. User Control and Data Deletion</h2>
            <p style="color:#3c2f2f; line-height:1.6;">
                Users have full control over their content and can delete their documents at any time.
                If you have an account with us, you may request data deletion by contacting our support team.
            </p>
        </section>

        <section class="mb-4">
            <h2 class="h5 text-warning mb-2">7. Changes to This Policy</h2>
            <p style="color:#3c2f2f; line-height:1.6;">
                We may update this Privacy Policy as necessary. Any changes will be posted with an updated effective date.
                Continued use of the service after updates signifies acceptance of the revised policy.
            </p>
        </section>

        <section class="mt-5">
            <blockquote class="mx-auto text-center" style="max-width:600px; color:#7a5b45; font-style:italic; font-size:1.05rem;">
                “Privacy is not an option, and it shouldn’t be the price we accept for just getting on the Internet.”
                <footer class="blockquote-footer mt-2" style="color:#a85e28;">Gary Kovacs</footer>
            </blockquote>
        </section>

    </div>
</div>
