@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5" style="background: linear-gradient(180deg, #fff9f5 0%, #faf7f2 100%); border-radius: 18px; box-shadow: 0 4px 14px rgba(100, 80, 60, 0.08);">

    <div class="container py-4">
        <h1 class="display-5 fw-bold mb-3" style="color:#a85e28; letter-spacing: 1px;">
            Welcome to <span style="color:#c07a3f;">словоредактор</span> 
        </h1>

        <p class="lead mx-auto" style="max-width: 700px; color:#4d3a35;">
            A warm, distraction-free space to let your words flow.
            Simple, elegant, and designed to keep you focused.
        </p>

        <div class="my-5">
            <div class="d-inline-block text-start bg-white p-4 rounded-4 shadow-sm" style="border:1px solid #eed9c4; min-width:300px;">
                <h2 class="h5 mb-3 text-center" style="color:#a85e28;"> Features</h2>
                <ul class="list-unstyled mb-0" style="color:#3c2f2f; line-height:1.8;">
                    <li> Simple and distraction-free writing interface</li>
                    <li> Auto-save — never lose your progress</li>
                    <li> Non-RAM consumating software</li>
                </ul>
            </div>
        </div>

        <div class="my-4">
            <a href="https://localhost:7255/Docs/" class="btn btn-lg px-5" style="
                background-color:#f3d8c2;
                color:#3b2c2a;
                border:none;
                border-radius:12px;
                font-weight:600;
                transition: all 0.3s ease;
                box-shadow:0 3px 8px rgba(160,120,90,0.15);
            "
               onmouseover="this.style.backgroundColor='#eac7a8';"
               onmouseout="this.style.backgroundColor='#f3d8c2';">
                Start Writing
            </a>
        </div>
        <blockquote class="mt-5 mx-auto" style="max-width:600px; color:#7a5b45; font-style:italic; font-size:1.05rem;">
            “The art of writing is the art of discovering what you believe.”
            <footer class="blockquote-footer mt-2" style="color:#a85e28;">Gustave Flaubert</footer>
        </blockquote>

    </div>
</div>


