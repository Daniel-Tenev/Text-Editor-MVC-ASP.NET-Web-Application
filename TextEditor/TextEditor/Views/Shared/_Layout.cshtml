<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TextEditor</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TextEditor.styles.css" asp-append-version="true" />

    <!-- TinyMCE -->
    <script src="https://cdn.tiny.cloud/1/461tuxspu9ulv0sjzcd1aybxshc7kem0qeok9oyn6jnrmzsv/tinymce/8/tinymce.min.js"
            referrerpolicy="origin" crossorigin="anonymous"></script>

    <script>
        tinymce.init({
            selector: 'textarea#tiny',
            plugins: [
                'anchor', 'autolink', 'charmap', 'code', 'codesample', 'emoticons',
                'link', 'lists', 'media', 'preview', 'searchreplace', 'table',
                'visualblocks', 'wordcount', 'pagebreak', 'insertdatetime'
            ],
            toolbar: 'undo redo | blocks fontfamily fontsize | ' +
                     'bold italic underline strikethrough | ' +
                     'align lineheight | bullist numlist outdent indent | ' +
                     'link media table | emoticons charmap | code preview removeformat',
            menubar: 'file edit view insert format tools table help',
            branding: false,
            promotion: false,
            skin: 'oxide',
            content_style: `
                body {
                    font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
                    background-color: #fffdfb;
                    color: #3c2f2f;
                    line-height: 1.6;
                    padding: 1rem;
                }
                a { color: #c07a3f; }
                a:hover { color: #a85e28; }
            `
        });
    </script>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm shadow-sm mb-4" style="background-color: #fff4ec; border-bottom: 1px solid #eed9c4;">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index" style="color: #a85e28;">
                    <img src="https://cdn-icons-png.flaticon.com/512/2989/2989993.png" alt="logo" width="26" height="26" class="me-2" />
                    TextEditor
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" style="color: #c07a3f;" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" style="color: #c07a3f;" asp-area="" asp-controller="Docs" asp-action="Index">My Docs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" style="color: #c07a3f;" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        @* Admin-only link – only visible to users in the Admin role *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 fw-semibold" style="color: #a85e28;"
                                   asp-controller="Admin" asp-action="Index">
                                    🛡️ Admin Panel
                                </a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container mb-5">
        <main role="main" class="pb-3">
            <div class="editor-container shadow-sm">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="text-center mt-auto py-3" style="background-color: #fff4ec; border-top: 1px solid #eed9c4;">
        <div class="container small text-muted">
            &copy; 2025 - <span style="color:#a85e28;">TextEditor</span> -
            <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color:#c07a3f; text-decoration:none;">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
